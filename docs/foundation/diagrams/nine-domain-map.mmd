flowchart TD
    classDef domain fill:#bfdbfe,stroke:#2563eb,stroke-width:2px,color:#1e40af,font-weight:bold
    classDef group fill:#f8fafc,stroke:#94a3b8,stroke-width:2px,color:#0f172a,stroke-dasharray: 5 5
    
    subgraph Identity [Identity / Entry]
        Acc[Account Lifecycle]:::domain
        Auth[Authentication / Session]:::domain
        Onb[Onboarding]:::domain
    end
    
    subgraph Foundation [Academic Foundation]
        Org[Organization]:::domain
        Time[Academic Time]:::domain
        Enr[Enrollment]:::domain
    end
    
    subgraph Participation [Participation]
        Comm[Community / Membership]:::domain
    end
    
    subgraph Authority [Authority / Access]
        Gov[Governance]:::domain
        Authz[Authorization]:::domain
    end
    
    Identity -.-> Foundation
    Foundation -.-> Participation
    Participation -.-> Authority
    
    class Identity,Foundation,Participation,Authority group;
