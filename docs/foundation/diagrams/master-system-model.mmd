flowchart TD
    classDef domain fill:#bfdbfe,stroke:#2563eb,stroke-width:2px,color:#1e40af,font-weight:bold
    classDef client fill:#fef08a,stroke:#ca8a04,stroke-width:2px,color:#854d0e,stroke-dasharray: 5 5
    classDef server fill:#f8fafc,stroke:#94a3b8,stroke-width:2px,color:#0f172a
    classDef process fill:#e0e7ff,stroke:#4f46e5,stroke-width:1px,color:#312e81
    
    subgraph Client [Client - Untrusted]
        Req[Client Requests]
    end
    
    subgraph Server [Server Authority - Authoritative State]
        Auth[Authentication / Session]:::domain
        Onb[Onboarding]:::domain
        Acc[Account Lifecycle]:::domain
        Org[Organization]:::domain
        Time[Academic Time]:::domain
        Enr[Enrollment]:::domain
        Comm[Community / Membership]:::domain
        Gov[Governance]:::domain
        Authz[Authorization]:::domain
        
        Appr((Approval)):::process
        Ctx((Academic Context)):::process
        BaseC((Base Community)):::process
        BaseM((Base Membership)):::process
        
        Req --> Auth
        Req --> Onb
        
        Onb -->|Profile Review| Appr
        
        Appr -->|Makes| Acc
        Appr -->|Establishes| Enr
        
        Org -.->|Provides structure| Enr
        Time -.->|Provides periods| Enr
        
        Enr --> Ctx
        Ctx --> BaseC
        BaseC --> BaseM
        BaseM --> Comm
        
        BaseC -.->|Provides target/context for| Gov
        
        Gov -->|Role + Context| Authz
        Comm -.->|Membership Context| Authz
        Acc -.->|Account Status| Authz
        Acc -.->|Invalidates sessions| Auth
        
        Authz -->|ALLOW / DENY| Req
    end
    
    class Client client;
    class Server server;
