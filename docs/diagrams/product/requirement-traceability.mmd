flowchart TD
    classDef step fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#0f172a,font-weight:bold

    P[Problem]
    UN[User Need]
    PR[Product Requirement]
    F[Feature]
    UC[Use Case]
    UX[UX Flow]
    S[Screen]
    API[API / Domain]
    D[Data]
    Sec[Security]
    OB[Offline Behavior]
    T[Test]
    A[Analytics]
    
    P --> UN
    UN --> PR
    PR --> F
    F --> UC
    UC --> UX
    UX --> S
    S --> API
    API --> D
    D --> Sec
    Sec --> OB
    OB --> T
    T --> A
    
    class P,UN,PR,F,UC,UX,S,API,D,Sec,OB,T,A step;
