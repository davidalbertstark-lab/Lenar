flowchart TD
    classDef step fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#0f172a,font-weight:bold

    SB[System Behavior]
    LMTE[Logs / Metrics / Traces / Errors]
    OB[Observability]
    DD[Detection / Diagnosis]
    OA[Operational Action]

    SB --> LMTE
    LMTE --> OB
    OB --> DD
    DD --> OA
    
    class SB,LMTE,OB,DD,OA step;
