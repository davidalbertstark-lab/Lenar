flowchart TD
    classDef main fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#0f172a,font-weight:bold

    U[USER / DEVICE]
    UC[UNTRUSTED CLIENT]
    API[SECURE API]
    AuthN[AUTHENTICATION]
    AuthZ[AUTHORIZATION]
    DR[DOMAIN RULES]
    AD[AUTHORITATIVE DATA]
    AM[AUDIT / MONITORING]
    
    U --> UC
    UC --> API
    API --> AuthN
    AuthN --> AuthZ
    AuthZ --> DR
    DR --> AD
    AD --> AM
    
    class U,UC,API,AuthN,AuthZ,DR,AD,AM main;
