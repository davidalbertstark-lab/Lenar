flowchart TD
    classDef step fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#0f172a,font-weight:bold

    D[Detect]
    T[Triage]
    C[Contain]
    I[Investigate]
    Rem[Remediate]
    Rec[Recover]
    V[Validate]
    Doc[Document]
    L[Learn]
    
    D --> T
    T --> C
    C --> I
    I --> Rem
    Rem --> Rec
    Rec --> V
    V --> Doc
    Doc --> L
    
    class D,T,C,I,Rem,Rec,V,Doc,L step;
